# Copy to .env and fill in the blanks:  cp .env.example .env
#
# The values below are local-development defaults and work as-is against the
# Postgres, Redis and MinIO containers in compose.yml. Blank values must be
# supplied. The resulting .env is gitignored — never commit it.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=one_day_investor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# node-pg-migrate reads this one directly; keep it in sync with the five above.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/one_day_investor

# The blog runs on its own database, created by docker/init-blog-db.sh
BLOG_POSTGRES_DB=blog

# Container-only: makes the core service run migrations on boot. It resolves
# the migrations path relative to the repo root, so it works in Docker (and in
# preview environments) but not when a service is started from apps/<name>.
# Locally, run `bun run migrate` instead.
AUTO_MIGRATE=false

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Google OAuth -----------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID.
# The authorised redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Session lifetime in seconds (30 days)
SESSION_MAX_AGE=2592000

# --- Service URLs -----------------------------------------------------------
CORE_URL=http://localhost:3000
ANALYTICS_URL=http://localhost:3001
MARKET_URL=http://localhost:3002
BLOG_URL=http://localhost:3003
OG_SERVICE_URL=http://localhost:3004
SITE_URL=http://localhost:3005
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173

# Baked into the frontend bundle at build time by Vite
VITE_API_URL=http://localhost:3000
VITE_ANALYTICS_URL=http://localhost:3001
VITE_MARKET_URL=http://localhost:3002
VITE_BLOG_URL=http://localhost:3003

# --- Exchange credentials ---------------------------------------------------
# AES-256-GCM key encrypting user exchange API keys at rest. Required for
# exchange sync. Generate with:  openssl rand -hex 32
# Rotating this key leaves every stored credential undecryptable.
EXCHANGE_ENCRYPTION_KEY=

# --- Mailgun (transactional email) ------------------------------------------
# Optional locally; only the reminder service sends mail.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="One Day Investor <postmaster@example.com>"

# --- S3 / MinIO -------------------------------------------------------------
# Defaults match the minio service in compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=testtest1
S3_BUCKET=blog-images
S3_PUBLIC_URL=http://localhost:9000/blog-images

# --- Admin ------------------------------------------------------------------
# Google account email granted access to admin routes. Left blank, every
# admin route returns 403.
ADMIN_EMAIL=
BLOG_ADMIN_EMAIL=

# --- Logging ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
