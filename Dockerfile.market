FROM oven/bun:latest AS base
WORKDIR /app

# Copy workspace structure for dependency install caching
COPY package.json bun.lock ./
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
COPY packages/types/package.json packages/types/
COPY packages/logger/package.json packages/logger/
COPY packages/market/package.json packages/market/
COPY apps/market/package.json apps/market/
COPY packages/ packages/
COPY apps/market/ apps/market/

RUN bun install

EXPOSE 3002
CMD ["bun", "run", "apps/market/src/index.ts"]
