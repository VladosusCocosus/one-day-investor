# Copy to .env on the server (chmod 600) and fill in real values.
# .env is gitignored — never commit real secrets.

# --- MySQL ---
# Generate strong values, e.g.  openssl rand -hex 24
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# --- Mailgun SMTP (transactional email) ---
# From Mailgun: Sending -> Domains -> <domain> -> SMTP credentials.
# US region host is smtp.mailgun.org (set in docker-compose.yml); EU is smtp.eu.mailgun.org.
MAIL_USER=blog@odinvestor.net
MAIL_PASS=your-mailgun-smtp-password
