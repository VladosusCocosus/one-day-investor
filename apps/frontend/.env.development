# Local development defaults, loaded automatically by Vite in dev mode.
# No secrets here — production values are injected as Docker build args
# (see docker/Dockerfile.frontend). A local .env overrides these and is
# gitignored.
VITE_API_URL=http://localhost:3000
VITE_ANALYTICS_URL=http://localhost:3001
VITE_MARKET_URL=http://localhost:3002
VITE_BLOG_URL=http://localhost:3003
